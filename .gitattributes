* text=auto
*.sh text eol=lf
*.py text eol=lf

# Docker reads the Dockerfile line by line; a CRLF turns `RUN sh -c foo` into
# `RUN sh -c foo\r` and the container fails at build time with a message that
# does not mention line endings. Same reason as the .sh rule above.
Dockerfile  text eol=lf
*.yaml      text eol=lf
